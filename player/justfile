# PLACEHOLDER: replace with `angzarr scaffold python` output.
#
# The player app (angzarr-player): a uv project run on the host (uv provides
# Python; none is assumed), launched by angzarr-embedded as a child process.

set shell := ["bash", "-euo", "pipefail", "-c"]

TOP := justfile_directory()
# The angzarr CLI, the buf codegen plugin (the repository's `just cli-build`
# builds it into ../.tools/bin).
CLI_DIR := env_var_or_default("ANGZARR_CLI_DIR", TOP / ".." / ".tools" / "bin")

default:
    @just --list

# Generate the player's message types and dispatch wiring into
# src/angzarr_player/_gen. policies.proto is passed only because player.proto
# names its policy (the CLI validates the declaration); the policies' wiring is
# the Rust side's, so it is removed.
proto-gen:
    rm -rf {{TOP}}/src/angzarr_player/_gen
    cd {{TOP}} && PATH="{{CLI_DIR}}:$PATH" buf generate \
        --path io/angzarr/examples/v1/player.proto \
        --path io/angzarr/examples/v1/cards.proto \
        --path io/angzarr/examples/v1/policies.proto
    rm -f {{TOP}}/src/angzarr_player/_gen/io/angzarr/examples/v1/*_policy_angzarr.py \
        {{TOP}}/src/angzarr_player/_gen/io/angzarr/examples/v1/policies_pb2.py*
    find {{TOP}}/src/angzarr_player/_gen -type d -exec touch {}/__init__.py \;
    cd {{TOP}} && uv run --no-project python ../tools/fixup_gen_imports.py \
        src/angzarr_player/_gen \
        io.angzarr.v1=angzarr_client.proto.io.angzarr.v1 \
        io.angzarr.examples.v1=angzarr_player._gen.io.angzarr.examples.v1

# The build version the host reports as its rules_version.
version:
    cd {{TOP}} && versionator output emit python --metadata > src/angzarr_player/_version.py.tmp
    mv {{TOP}}/src/angzarr_player/_version.py.tmp {{TOP}}/src/angzarr_player/_version.py

# Generated code, the build version, and the locked environment.
install: proto-gen version
    cd {{TOP}} && uv sync --locked

test:
    cd {{TOP}} && uv run --locked pytest

# The player's test gate the repository's git hooks run, under the
# red-on-branches rule: red tests (pytest exit 1) pass off the default branch
# with a warning that the branch cannot merge until they pass, and fail on the
# default branch and on a merge commit. Every other failure (no environment,
# collection errors) fails everywhere. Needs `just install` once.
test-commit merging="":
    #!/usr/bin/env bash
    set -uo pipefail
    cd {{TOP}}
    uv run --locked pytest
    status=$?
    [ "$status" -eq 0 ] && exit 0
    [ "$status" -ne 1 ] && exit "$status"
    default="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)"
    default="${default#origin/}"
    default="${default:-main}"
    branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo HEAD)"
    if [ -n "{{merging}}" ]; then
        echo "FAIL player tests: red tests cannot be merged" >&2
        exit 1
    fi
    if [ "$branch" = "$default" ] || [ "$branch" = "HEAD" ]; then
        echo "FAIL player tests: red tests cannot be committed on $branch; commit them on a branch" >&2
        exit 1
    fi
    echo "RED  player tests: red tests committed on $branch, allowed off $default; $branch cannot merge into $default until they pass" >&2
    exit 0
