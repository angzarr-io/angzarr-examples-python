# The player app (angzarr-player): a uv project run on the host (uv provides
# Python; none is assumed), launched by angzarr-embedded as a child process.
# `angzarr scaffold python` wrote it, and rewrites its generated files
# (`just scaffold`): domain.py, the dispatch under _gen, _descriptor.py,
# main.py, __main__.py, _version.py and buf.gen.yaml. logic_impl.py,
# strategy.py and the tests are the player's own.

set shell := ["bash", "-euo", "pipefail", "-c"]

TOP := justfile_directory()
# The angzarr CLI whose Python scaffold wrote this project, built from
# angzarr-cli at this revision into .tools/ (`just cli`). ANGZARR_CLI points
# at another binary instead.
CLI_REV := "444448d4657573f62fa054c69428c1cf086dccd2"
CLI := env_var_or_default("ANGZARR_CLI", TOP / ".tools" / "bin" / "angzarr")
# The angzarr-project revision whose protos the player is written against.
SPEC_REV := "74690c7e09b163ca02a607b07eb370cdd70bed76"
SPEC_GIT := "https://github.com/angzarr-io/angzarr-project.git"

default:
    @just --list

# Install the angzarr CLI at CLI_REV into .tools/ with cargo (skipped when
# ANGZARR_CLI names another binary).
cli:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -n "${ANGZARR_CLI:-}" ]; then exit 0; fi
    if [ -x "{{CLI}}" ] && [ "$(cat {{TOP}}/.tools/angzarr.rev 2>/dev/null)" = "{{CLI_REV}}" ]; then exit 0; fi
    cargo install --quiet --locked --git https://github.com/angzarr-io/angzarr-cli --rev {{CLI_REV}} angzarr-cli --root {{TOP}}/.tools
    echo "{{CLI_REV}}" > {{TOP}}/.tools/angzarr.rev

# Rewrite the generated files from the protos at SPEC_REV, the build version
# (VERSION) the domain reports as its rules_version, and the lock.
scaffold: cli
    #!/usr/bin/env bash
    set -euo pipefail
    spec="$(mktemp -d)"
    trap 'rm -rf "$spec"' EXIT
    git -C "$spec" init --quiet
    git -C "$spec" fetch --quiet --depth 1 {{SPEC_GIT}} {{SPEC_REV}}
    git -C "$spec" checkout --quiet FETCH_HEAD -- proto
    cd {{TOP}}/.. && "{{CLI}}" --format text scaffold python -I "$spec/proto" \
        --src player --domain player --rules-version "$(cat {{TOP}}/VERSION)" \
        --proto-git {{SPEC_GIT}} --proto-ref {{SPEC_REV}} \
        io/angzarr/examples/v1/player.proto

# The locked environment.
install:
    cd {{TOP}} && uv sync --locked

test:
    cd {{TOP}} && uv run --locked pytest

# The player's test gate the repository's git hooks run, under the
# red-on-branches rule: red tests (pytest exit 1) pass off the default branch
# with a warning that the branch cannot merge until they pass, and fail on the
# default branch and on a merge commit. Every other failure (no environment,
# collection errors) fails everywhere. Needs `just install` once.
test-commit merging="":
    #!/usr/bin/env bash
    set -uo pipefail
    cd {{TOP}}
    uv run --locked pytest
    status=$?
    [ "$status" -eq 0 ] && exit 0
    [ "$status" -ne 1 ] && exit "$status"
    default="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)"
    default="${default#origin/}"
    default="${default:-main}"
    branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo HEAD)"
    if [ -n "{{merging}}" ]; then
        echo "FAIL player tests: red tests cannot be merged" >&2
        exit 1
    fi
    if [ "$branch" = "$default" ] || [ "$branch" = "HEAD" ]; then
        echo "FAIL player tests: red tests cannot be committed on $branch; commit them on a branch" >&2
        exit 1
    fi
    echo "RED  player tests: red tests committed on $branch, allowed off $default; $branch cannot merge into $default until they pass" >&2
    exit 0

# Mutation testing: mutmut over the player's own code (pyproject
# [tool.mutmut]), killed by its pytest suite. Fails below a 90% kill rate.
# With no paths, every mutant (the scheduled CI pass); given the
# repository-relative paths a push changed (the pre-push hook), only the
# mutants of the changed modules, and nothing when none is mutated.
mutation-test *CHANGED:
    #!/usr/bin/env bash
    set -euo pipefail
    cd {{TOP}}/..
    only=()
    if [ -n "{{CHANGED}}" ]; then
        globs="$(python3 tools/mutation_scope.py player {{CHANGED}})"
        read -ra only <<< "$globs"
        if [ "${#only[@]}" -eq 0 ]; then
            echo "player mutation: the push changes no mutated module"
            exit 0
        fi
    fi
    cd player
    rm -rf mutants
    uv run --locked mutmut run --max-children "${MUTMUT_CHILDREN:-4}" "${only[@]}"
    uv run --locked python ../tools/mutation_gate.py mutants 90 "${only[@]}"
