# Angzarr blackjack example (Python) — container recipes.
#
# Mounted as `justfile` inside the dev container (see the host justfile's
# `_container`) and used directly by CI container jobs. Every recipe runs from
# the repository root.

set shell := ["bash", "-euo", "pipefail", "-c"]

# The six deployable components (Containerfile target == image suffix).
COMPONENTS := "agg-player agg-table pmg-buy-in saga-player-table saga-table-player projector-player-table-ledger"

# Source checkouts for the angzarr CLI (codegen plugin) and the angzarr-router
# Python binding + cdylib. Neither is a published package yet.
CLI_SRC := env_var_or_default("ANGZARR_CLI_SRC", "../../angzarr-cli/main")
ROUTER_SRC := env_var_or_default("ANGZARR_ROUTER_SRC", "../../angzarr-router/main")
ROUTER_CDYLIB := env_var_or_default("ANGZARR_ROUTER_CDYLIB", ROUTER_SRC + "/target/debug/libangzarr_router_ffi.so")

# The binding's cdylib, once staged by vendor-router.
ROUTER_LIB := justfile_directory() + "/vendor/angzarr-router-ffi/libangzarr_router_ffi.so"

# Features: the in-process tiers and the cluster tier, read straight from the
# angzarr-project submodule.
UNIT_FEATURES := "angzarr-project/features/example/blackjack angzarr-project/features/example/blackjack-framework"
ACCEPTANCE_FEATURES := "angzarr-project/features/example/blackjack-acceptance"

default:
    @just --list

# The component list, for CI matrices.
components:
    @echo {{COMPONENTS}}

# Build the angzarr CLI (the buf `angzarr codegen python` plugin) into .tools/bin.
cli-build:
    mkdir -p .tools/bin
    cd {{CLI_SRC}} && go build -o {{justfile_directory()}}/.tools/bin/angzarr .

# Stage the angzarr-router Python binding under vendor/angzarr-router-ffi: its
# Python sources, the cdylib, and its generated protobuf tree. The framework
# protos come from this repo's angzarr-project pin (not the router's), so the
# binding and the example register byte-identical framework descriptors.
vendor-router:
    rm -rf vendor/angzarr-router-ffi
    mkdir -p vendor/angzarr-router-ffi/angzarr_router_ffi
    cp {{ROUTER_SRC}}/bindings/python/pyproject.toml vendor/angzarr-router-ffi/
    cp {{ROUTER_SRC}}/bindings/python/angzarr_router_ffi/*.py vendor/angzarr-router-ffi/angzarr_router_ffi/
    cp {{ROUTER_CDYLIB}} vendor/angzarr-router-ffi/libangzarr_router_ffi.so
    buf generate angzarr-project/proto --template tools/router-binding.gen.yaml \
        --exclude-path angzarr-project/proto/google \
        --exclude-path angzarr-project/proto/io/angzarr/examples
    buf generate {{ROUTER_SRC}} --template tools/router-binding.gen.yaml \
        --path {{ROUTER_SRC}}/proto/io/angzarr/router
    python3 {{ROUTER_SRC}}/bindings/python/scripts/fixup_gen_imports.py \
        vendor/angzarr-router-ffi/angzarr_router_ffi/gen

# Generate message types, gRPC stubs and angzarr dispatch wiring into
# src/angzarr_blackjack/_gen, then rewrite the buf imports to relative so the
# tree is self-contained (never shadows stdlib `io`). google/* is not
# generated: it comes from the protobuf runtime and googleapis-common-protos,
# exactly as the binding does.
proto-gen:
    rm -rf src/angzarr_blackjack/_gen
    PATH="{{justfile_directory()}}/.tools/bin:$PATH" buf generate --exclude-path angzarr-project/proto/google
    buf build angzarr-project/proto -o .gen-image.binpb
    uvx --from protoletariat protol --create-package --in-place --python-out src/angzarr_blackjack/_gen \
        --exclude-imports-glob 'google/*' raw .gen-image.binpb
    rm -f .gen-image.binpb

# Generate code and sync the environment.
install *FLAGS: proto-gen
    uv sync {{FLAGS}}

# Native unit tests: pure handler logic, rules, shoe golden vectors, ledger
# property tests.
test-unit:
    ANGZARR_ROUTER_LIB="{{ROUTER_LIB}}" uv run pytest tests/unit

# The behave unit tier: every blackjack and blackjack-framework scenario, run
# in-process through the router binding. Undefined or pending steps fail.
test-example-unit:
    ANGZARR_ROUTER_LIB="{{ROUTER_LIB}}" uv run behave --stage unit --format progress \
        --no-skipped --tags="not @wip" {{UNIT_FEATURES}}

# The cluster acceptance tier against a deployed example. Scenarios that wait
# on a framework fix (@needs-core-X-NNN) are excluded from the required run.
test-example-acceptance:
    ANGZARR_ROUTER_LIB="{{ROUTER_LIB}}" uv run behave --stage acceptance --format progress \
        --tags="not @wip and not @needs-core-X-012 and not @needs-core-X-014 and not @needs-core-X-016 and not @needs-core-X-021 and not @needs-core-X-023 and not @needs-core-X-031 and not @needs-core-X-034 and not @needs-core-X-089 and not @needs-core-X-092 and not @needs-core-X-110" \
        {{ACCEPTANCE_FEATURES}}

# Parse every acceptance scenario and resolve every step without a cluster.
acceptance-dry-run:
    ANGZARR_ROUTER_LIB="{{ROUTER_LIB}}" uv run behave --stage acceptance --dry-run --format progress \
        {{ACCEPTANCE_FEATURES}}

# Unit + behave tiers.
test: test-unit test-example-unit

# CI entry point for the test job.
ci-test: lint (fmt "--check") test acceptance-dry-run

fmt *FLAGS:
    uv run black {{FLAGS}} src tests unit_steps acceptance_steps tools unit_environment.py acceptance_environment.py

fmt-fix:
    uv run ruff check --fix src tests unit_steps acceptance_steps tools unit_environment.py acceptance_environment.py
    uv run black src tests unit_steps acceptance_steps tools unit_environment.py acceptance_environment.py

lint:
    uv run ruff check src tests unit_steps acceptance_steps tools unit_environment.py acceptance_environment.py

# Run one component locally (e.g. `just run agg-player`).
run component:
    ANGZARR_ROUTER_LIB="{{ROUTER_LIB}}" PYTHONPATH=src uv run python -m \
        "angzarr_blackjack.$(just -f {{justfile()}} _module {{component}})"

[private]
_module component:
    #!/usr/bin/env bash
    case "{{component}}" in
        agg-player) echo player.agg.main ;;
        agg-table) echo table.agg.main ;;
        pmg-buy-in) echo pmg_buy_in.main ;;
        saga-player-table) echo player.saga_table.main ;;
        saga-table-player) echo table.saga_player.main ;;
        projector-player-table-ledger) echo prj_ledger.main ;;
        *) echo "unknown component {{component}}" >&2; exit 1 ;;
    esac

# Drive a short basic-strategy session against a deployed cluster.
demo-session *ARGS:
    ANGZARR_ROUTER_LIB="{{ROUTER_LIB}}" PYTHONPATH=.:src uv run python tools/play_session.py {{ARGS}}

# Mutation testing (mutmut over the business logic, killed by pytest + the
# behave bridge). Fails below a 90% kill rate.
mutation-test:
    #!/usr/bin/env bash
    set -euo pipefail
    rm -rf mutants
    export ANGZARR_ROUTER_LIB="{{ROUTER_LIB}}"
    uv run mutmut run --max-children "${MUTMUT_CHILDREN:-4}" || true
    uv run mutmut export-cicd-stats
    python3 tools/mutation_gate.py mutants/mutmut-cicd-stats.json 90
