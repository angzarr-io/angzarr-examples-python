# Angzarr blackjack example (Python) — container recipes.
#
# Mounted as `justfile` inside the dev container (see the host justfile's
# `_container`) and used directly by CI container jobs. Every recipe runs from
# the repository root.

set shell := ["bash", "-euo", "pipefail", "-c"]

# The six deployable components (Containerfile target == image suffix).
COMPONENTS := "agg-player agg-table pmg-buy-in saga-player-table saga-table-player projector-player-table-ledger"

# The angzarr CLI (codegen plugin) is built from a source checkout.
CLI_SRC := env_var_or_default("ANGZARR_CLI_SRC", "../../angzarr-cli/main")
# The angzarr-client revision whose codegen templates render the wiring; the
# pyproject pins the same revision.
CLIENT_REF := "5e373719f6aba8f8d84bc3006de4bcc8075ae72d"

# Features: the in-process tiers and the cluster tier, read straight from the
# angzarr-project submodule.
UNIT_FEATURES := "angzarr-project/features/example/blackjack angzarr-project/features/example/blackjack-framework"
ACCEPTANCE_FEATURES := "angzarr-project/features/example/blackjack-acceptance"

default:
    @just --list

# The component list, for CI matrices.
components:
    @echo {{COMPONENTS}}

# Build the angzarr CLI (the buf `angzarr codegen python` plugin) into .tools/bin.
cli-build:
    mkdir -p .tools/bin
    cd {{CLI_SRC}} && go build -o {{justfile_directory()}}/.tools/bin/angzarr .

# Everything a fresh checkout needs before tests or image builds: the CLI,
# generated code and the environment (installing angzarr-client builds its
# router library with cargo).
ci-setup: cli-build install

# Generate the blackjack message types, gRPC stubs and angzarr dispatch wiring
# into src/angzarr_blackjack/_gen, then reroot the plugins' path imports:
# framework protos under angzarr_client.proto, the example protos under the
# package (never shadowing stdlib `io`).
proto-gen:
    rm -rf src/angzarr_blackjack/_gen
    PATH="{{justfile_directory()}}/.tools/bin:$PATH" buf generate \
        --path angzarr-project/proto/io/angzarr/examples
    touch src/angzarr_blackjack/_gen/__init__.py
    uv run python tools/fixup_gen_imports.py \
        src/angzarr_blackjack/_gen \
        io.angzarr.v1=angzarr_client.proto.io.angzarr.v1 \
        io.angzarr.status=angzarr_client.proto.io.angzarr.status \
        sererr=angzarr_client.proto.sererr \
        io.angzarr.examples.v1=angzarr_blackjack._gen.io.angzarr.examples.v1

# Generate code and sync the environment.
install *FLAGS: proto-gen
    uv sync {{FLAGS}}

# Native unit tests: pure handler logic, rules, shoe golden vectors, ledger
# property tests.
test-unit:
    uv run pytest tests/unit

# The behave unit tier: every blackjack and blackjack-framework scenario, run
# in-process through the router binding. Undefined or pending steps fail.
test-example-unit:
    uv run behave --stage unit --format progress \
        --no-skipped --tags="not @wip" {{UNIT_FEATURES}}

# The cluster acceptance tier against a deployed example. Scenarios that wait
# on a framework fix (@needs-core-X-NNN) are excluded from the required run.
test-example-acceptance:
    uv run behave --stage acceptance --format progress \
        --tags="not @wip and not @needs-core-*" \
        {{ACCEPTANCE_FEATURES}}

# Parse every acceptance scenario and resolve every step without a cluster.
acceptance-dry-run:
    uv run behave --stage acceptance --dry-run --format progress \
        {{ACCEPTANCE_FEATURES}}

# Unit + behave tiers.
test: test-unit test-example-unit

# CI entry point for the test job.
ci-test: lint (fmt "--check") test acceptance-dry-run

fmt *FLAGS:
    uv run black {{FLAGS}} src tests unit_steps acceptance_steps tools unit_environment.py acceptance_environment.py

fmt-fix:
    uv run ruff check --fix src tests unit_steps acceptance_steps tools unit_environment.py acceptance_environment.py
    uv run black src tests unit_steps acceptance_steps tools unit_environment.py acceptance_environment.py

lint:
    uv run ruff check src tests unit_steps acceptance_steps tools unit_environment.py acceptance_environment.py

# Run one component locally (e.g. `just run agg-player`).
run component:
    PYTHONPATH=src uv run python -m \
        "angzarr_blackjack.$(just -f {{justfile()}} _module {{component}})"

[private]
_module component:
    #!/usr/bin/env bash
    case "{{component}}" in
        agg-player) echo player.agg.main ;;
        agg-table) echo table.agg.main ;;
        pmg-buy-in) echo pmg_buy_in.main ;;
        saga-player-table) echo player.saga_table.main ;;
        saga-table-player) echo table.saga_player.main ;;
        projector-player-table-ledger) echo prj_ledger.main ;;
        *) echo "unknown component {{component}}" >&2; exit 1 ;;
    esac

# Drive a short basic-strategy session against a deployed cluster.
demo-session *ARGS:
    PYTHONPATH=.:src uv run python tools/play_session.py {{ARGS}}

# Mutation testing (mutmut over the business logic, killed by pytest + the
# behave bridge). Fails below a 90% kill rate.
mutation-test:
    #!/usr/bin/env bash
    set -euo pipefail
    rm -rf mutants
    uv run mutmut run --max-children "${MUTMUT_CHILDREN:-4}"
    uv run python tools/mutation_gate.py mutants 90
