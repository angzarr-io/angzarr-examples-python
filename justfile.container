# Angzarr Python Examples - container version
# This file is mounted as 'justfile' inside the container
# Also used directly in CI container jobs

set shell := ["bash", "-c"]

default:
    @just --list

# Generate message types + angzarr dispatch wiring into src/angzarr_poker/_gen,
# then protoletariat rewrites the buf pb2/grpc imports to relative so the tree is
# self-contained under angzarr_poker._gen (never shadows stdlib `io`). Wiring
# (*_angzarr.py) is regenerated each run; ported business logic lives in the
# committed, skip-if-exists *_angzarr_handler.py scaffolds.
#
# google/* is NOT generated: it comes from the protobuf runtime + the installed
# googleapis-common-protos (the standard-over-rolling precedent). The FFI binding
# this package imports does the same, so a locally-generated google/api/*.proto
# would collide with googleapis-common-protos in the global descriptor pool
# ("duplicate file name google/api/http.proto"). Exclude it from both the buf
# generate and the protol image; the framework pb2's `from google.api import ...`
# then resolves to the installed package.
proto-gen:
    buf generate --exclude-path angzarr-project/proto/google
    buf build angzarr-project/proto -o .gen-image.binpb
    uvx --from protoletariat protol --create-package --in-place --python-out src/angzarr_poker/_gen \
        --exclude-imports-glob 'google/*' raw .gen-image.binpb
    rm -f .gen-image.binpb

# Generate AI Player protos (runs buf inside ai_player/). Generated files are
# gitignored; regenerate here whenever the ai_sidecar.proto contract changes.
ai-proto:
    cd ai_player && buf generate

# Install dependencies AND regenerate protos (generated code is not committed).
install *FLAGS: proto-gen ai-proto
    uv sync {{FLAGS}}

# Run plain pytest unit/integration tests (uses testpaths from pyproject.toml)
test-pytest:
    uv run pytest -v

# Unit-example cucumber: poker business rules driven through the generated FFI
# dispatch wiring (in-process router, no infra). Feature files live in
# angzarr-project/features/example/{poker,framework}/ (submodule; the legacy
# unit/ tree was reorganized in the split-poker reframe). behave's --stage
# mechanism finds unit_environment.py + unit_steps/ at this repo root via walk-up
# from the feature files — no symlinks needed. The binding's cdylib is resolved
# via ANGZARR_ROUTER_LIB or the in-repo build dir.
test-example-unit:
    ANGZARR_ROUTER_LIB="$PWD/vendor/angzarr-router-ffi/libangzarr_router_ffi.so" uv run behave --stage unit angzarr-project/features/example/poker angzarr-project/features/example/framework --tags="~@wip"

# Acceptance-example cucumber: poker E2E via CommandClient (gRPC).
# Drives a DEPLOYED cluster: the harness talks straight to each aggregate
# coordinator on its NodePort (player 31320 … reservation 31324), which the
# kind cluster maps to the host and the dev container shares via --network=host
# — no `kubectl port-forward` needed. Override a domain with <DOMAIN>_URL
# (PLAYER_URL / TABLE_URL / HAND_URL / TOURNAMENT_URL / RESERVATION_URL) to
# point at a different / remote cluster.
# --stage acceptance resolves acceptance_environment.py + acceptance_steps/.
test-example-acceptance:
    ANGZARR_ROUTER_LIB="$PWD/vendor/angzarr-router-ffi/libangzarr_router_ffi.so" uv run behave --stage acceptance angzarr-project/features/example/acceptance/ --tags="~@wip"

# Run all tests
test: test-pytest test-example-unit test-example-acceptance

# Format code (use --check for CI)
fmt *FLAGS:
    uv run black {{FLAGS}} .

# Lint code
lint:
    uv run ruff check . --exclude angzarr-client-python

# Type check
typecheck:
    uv run mypy . --ignore-missing-imports

# Run player aggregate
run-player:
    uv run python -m angzarr_poker.player.aggregate.main

# Run table aggregate
run-table:
    uv run python -m angzarr_poker.table.aggregate.main

# Run hand aggregate
run-hand:
    uv run python -m angzarr_poker.hand.aggregate.main

# Run game with AI Player service
run-game-ai *ARGS:
    uv run python run_game.py --ai-player localhost:50500 --no-standalone {{ARGS}}

# Run mutation testing with mutmut (80% kill threshold)
mutation-test:
    #!/usr/bin/env bash
    set -euo pipefail
    rm -rf mutants
    uv run mutmut run
    uv run mutmut results
    uv run mutmut export-cicd-stats
    # Check survival rate is below 20% (i.e., 80%+ killed)
    TOTAL=$(python -c "import json; d=json.load(open('mutants/mutmut-cicd-stats.json')); print(d['total'])")
    SURVIVED=$(python -c "import json; d=json.load(open('mutants/mutmut-cicd-stats.json')); print(d['survived'])")
    if [ "$TOTAL" -eq 0 ]; then
        echo "ERROR: No mutants were generated"
        exit 1
    fi
    SURVIVAL_RATE=$((SURVIVED * 100 / TOTAL))
    echo "Survival rate: ${SURVIVAL_RATE}% (${SURVIVED}/${TOTAL})"
    if [ "$SURVIVAL_RATE" -gt 20 ]; then
        echo "FAIL: Survival rate ${SURVIVAL_RATE}% exceeds 20% threshold (need 80%+ killed)"
        exit 1
    fi
    echo "PASS: Mutation testing threshold met"

# Auto-format code
fmt-fix:
    uv run ruff check --fix . --exclude angzarr-client-python
    uv run black .
