# Angzarr Python Examples - container version
# This file is mounted as 'justfile' inside the container
# Also used directly in CI container jobs

set shell := ["bash", "-c"]

default:
    @just --list

# Generate poker domain protos from buf registry
proto-gen:
    buf generate
    find poker/proto -name "*.py" -exec sed -i 's/from poker import/from poker.proto.poker import/g' {} \;

# Generate AI Player protos (runs buf inside ai_player/). Generated files are
# gitignored; regenerate here whenever the ai_sidecar.proto contract changes.
ai-proto:
    cd ai_player && buf generate

# Install dependencies AND regenerate protos (generated code is not committed).
install *FLAGS: proto-gen ai-proto
    uv sync {{FLAGS}}

# Run plain pytest unit/integration tests (uses testpaths from pyproject.toml)
test-pytest:
    uv run pytest -v

# Unit-example cucumber: poker handler logic, direct invocation, no infra.
# Feature files live in angzarr-project/features/example/unit/ (git submodule);
# behave discovers steps/ + environment.py via relative sibling symlinks.
test-example-unit:
    #!/usr/bin/env bash
    set -euo pipefail
    ln -sfn ../../../../tests/example/unit/steps angzarr-project/features/example/unit/steps
    ln -sfn ../../../../tests/example/unit/environment.py angzarr-project/features/example/unit/environment.py
    uv run behave angzarr-project/features/example/unit/ --tags="~@wip"

# Acceptance-example cucumber: poker E2E via CommandClient.
# PLAYER_URL set → GrpcClient to coordinator; unset → InProcessClient.
test-example-acceptance:
    #!/usr/bin/env bash
    set -euo pipefail
    ln -sfn ../../../../tests/example/acceptance/steps angzarr-project/features/example/acceptance/steps
    ln -sfn ../../../../tests/example/acceptance/environment.py angzarr-project/features/example/acceptance/environment.py
    PLAYER_URL="${PLAYER_URL:-}" uv run behave angzarr-project/features/example/acceptance/ --tags="~@wip"

# Run all tests
test: test-pytest test-example-unit test-example-acceptance

# Format code (use --check for CI)
fmt *FLAGS:
    uv run black {{FLAGS}} .

# Lint code
lint:
    uv run ruff check . --exclude angzarr-client-python

# Type check
typecheck:
    uv run mypy . --ignore-missing-imports

# Run player aggregate
run-player:
    cd player/agg && uv run python main.py

# Run table aggregate
run-table:
    cd table/agg && uv run python main.py

# Run hand aggregate
run-hand:
    cd hand/agg && uv run python main.py

# Run game with AI Player service
run-game-ai *ARGS:
    uv run python run_game.py --ai-player localhost:50500 --no-standalone {{ARGS}}

# Run mutation testing with mutmut (70% kill threshold)
mutation-test:
    #!/usr/bin/env bash
    set -euo pipefail
    rm -rf mutants
    uv run mutmut run
    uv run mutmut results
    uv run mutmut export-cicd-stats
    # Check survival rate is below 30% (i.e., 70%+ killed)
    TOTAL=$(python -c "import json; d=json.load(open('mutants/mutmut-cicd-stats.json')); print(d['total'])")
    SURVIVED=$(python -c "import json; d=json.load(open('mutants/mutmut-cicd-stats.json')); print(d['survived'])")
    if [ "$TOTAL" -eq 0 ]; then
        echo "ERROR: No mutants were generated"
        exit 1
    fi
    SURVIVAL_RATE=$((SURVIVED * 100 / TOTAL))
    echo "Survival rate: ${SURVIVAL_RATE}% (${SURVIVED}/${TOTAL})"
    if [ "$SURVIVAL_RATE" -gt 30 ]; then
        echo "FAIL: Survival rate ${SURVIVAL_RATE}% exceeds 30% threshold (need 70%+ killed)"
        exit 1
    fi
    echo "PASS: Mutation testing threshold met"

# Auto-format code
fmt-fix:
    uv run ruff check --fix . --exclude angzarr-client-python
    uv run black .
