# Angzarr Python Examples - container version
# This file is mounted as 'justfile' inside the container
# Also used directly in CI container jobs

set shell := ["bash", "-c"]

default:
    @just --list

# Generate poker domain protos from buf registry
proto-gen:
    buf generate
    find poker/proto -name "*.py" -exec sed -i 's/from poker import/from poker.proto.poker import/g' {} \;

# Install dependencies (use --no-sources in CI to skip local paths)
install *FLAGS:
    uv sync {{FLAGS}}

# Run unit tests (uses testpaths from pyproject.toml)
test-unit:
    uv run pytest -v

# Run acceptance tests (Gherkin/behave) against deployed system or in-process
# PLAYER_URL set → GrpcClient to coordinator; unset → InProcessClient
test-acceptance:
    PLAYER_URL="${PLAYER_URL:-}" uv run behave tests/acceptance/features/ --tags="~@wip"

# Run unit-level behave specs (existing feature files)
test-behave-unit:
    uv run behave features/specs/ --tags="~@wip"

# Run all tests
test: test-unit test-behave-unit test-acceptance

# Format code (use --check for CI)
fmt *FLAGS:
    uv run black {{FLAGS}} .

# Lint code
lint:
    uv run ruff check .

# Type check
typecheck:
    uv run mypy . --ignore-missing-imports

# Run player aggregate
run-player:
    cd player/agg && uv run python main.py

# Run table aggregate
run-table:
    cd table/agg && uv run python main.py

# Run hand aggregate
run-hand:
    cd hand/agg && uv run python main.py

# Run game with AI Player service
run-game-ai *ARGS:
    uv run python run_game.py --ai-player localhost:50500 --no-standalone {{ARGS}}
