# Angzarr Python examples — container recipes.
#
# Mounted as `justfile` inside the dev container (see the host justfile's
# `_container`) and used directly by CI container jobs. Every recipe runs from
# the repository root, in the root's tooling environment (pyproject.toml): the
# formatter and linter over the player app, and the tests of tools/. The
# player app itself runs on the host (player/justfile).

set shell := ["bash", "-euo", "pipefail", "-c"]

default:
    @just --list

# The tooling environment.
install *FLAGS:
    uv sync --locked {{FLAGS}}

# The repository's own tooling (tools/test_*.py).
test-tools:
    uv run --locked pytest -p no:cacheprovider tools

# Every root test: the tooling's.
test: test-tools

# CI entry point for the test job.
ci-test: lint (fmt "--check") test

fmt *FLAGS:
    uv run --locked black {{FLAGS}} tools player/src player/tests

fmt-fix:
    uv run --locked ruff check --fix tools player/src player/tests
    uv run --locked black tools player/src player/tests

lint:
    uv run --locked ruff check tools player/src player/tests
