# AI Player Service Containerfile
# Multi-stage build with UV for fast dependency management

# =============================================================================
# Base stage - Python with UV and buf
# =============================================================================
FROM python:3.11-slim AS base

# Install UV
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    netcat-openbsd \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install buf CLI
RUN ARCH=$(dpkg --print-architecture) && \
    case "$ARCH" in \
        amd64) BUF_ARCH="x86_64" ;; \
        arm64) BUF_ARCH="aarch64" ;; \
        *) echo "Unsupported architecture: $ARCH" && exit 1 ;; \
    esac && \
    curl -fLo /usr/local/bin/buf \
        "https://github.com/bufbuild/buf/releases/download/v1.47.2/buf-Linux-${BUF_ARCH}" && \
    chmod +x /usr/local/bin/buf

WORKDIR /app

# =============================================================================
# Dependencies stage - Install Python packages
# =============================================================================
FROM base AS dependencies

# Copy dependency files
COPY ai_player/pyproject.toml ai_player/uv.lock* ./

# Install dependencies (using CPU-only PyTorch via pyproject.toml index). The
# ai_player is self-contained: it generates its own proto stubs (proto stage)
# and does not depend on the EOL angzarr-client-python package.
RUN uv sync --no-dev --frozen

# =============================================================================
# Proto stage - Generate proto stubs
# =============================================================================
FROM dependencies AS proto

# Copy buf config
COPY ai_player/buf.gen.yaml ./

# The buf.gen.yaml references the angzarr-project submodule at
# ../angzarr-project/proto (relative to the ai_player dir). WORKDIR is /app
# so uv/buf looks at /angzarr-project/proto — provide it in the build context.
COPY angzarr-project/ /angzarr-project/

# Generate proto stubs, then rewrite buf's absolute imports to relative ones
# with protoletariat so the tree is self-contained under ai_player._gen (never
# shadows stdlib `io`), mirroring the main package's proto-gen. google/* is
# excluded from generation — google.protobuf well-known types resolve from the
# protobuf runtime, the same precedent the main package follows. `uv tool run`
# is uvx without needing the separate uvx binary in the image.
RUN uv run buf generate --exclude-path ../angzarr-project/proto/google && \
    uv run buf build ../angzarr-project/proto -o .gen-image.binpb && \
    uv tool run --from protoletariat protol --create-package --in-place \
        --python-out _gen --exclude-imports-glob 'google/*' raw .gen-image.binpb && \
    rm -f .gen-image.binpb

# =============================================================================
# Production stage
# =============================================================================
FROM dependencies AS production

# Copy application source as ai_player package
COPY ai_player/ ./ai_player/

# Copy generated protos into the ai_player package
COPY --from=proto /app/_gen ./ai_player/_gen/

# Create models directory
RUN mkdir -p /models/current /models/versions

ENV PORT=50500
ENV DEVICE=cpu
ENV LOG_LEVEL=INFO
# /app is the package root so `import ai_player` and its _gen protos resolve.
ENV PYTHONPATH=/app

EXPOSE 50500

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD .venv/bin/python -c "import grpc; ch = grpc.insecure_channel('localhost:50500'); grpc.channel_ready_future(ch).result(timeout=5)" || exit 1

# Run directly from venv (no uv run to avoid runtime sync)
CMD [".venv/bin/python", "-m", "ai_player.main"]

# =============================================================================
# Training stage - With additional training dependencies
# =============================================================================
FROM dependencies AS training

# Install training dependencies
RUN uv sync --group training --no-install-project

# Copy application source as ai_player package
COPY ai_player/ ./ai_player/

# Copy generated protos into the ai_player package
COPY --from=proto /app/_gen ./ai_player/_gen/

ENV DEVICE=cpu
# /app is the package root so `import ai_player` and its _gen protos resolve.
ENV PYTHONPATH=/app

CMD ["uv", "run", "python", "-m", "ai_player.training.train_rl"]

# =============================================================================
# Self-play training stage - Runs self-play tournaments in cluster
# =============================================================================
FROM training AS self-play

# Copy additional files needed for self-play (from parent directory)
COPY run_game.py client.py ./
COPY prj_training/ ./prj_training/

# Set mode to use K8s DNS for aggregate connections
ENV ANGZARR_MODE=distributed
# /app is the package root for ai_player, prj_training, run_game, and client.
ENV PYTHONPATH=/app

CMD ["uv", "run", "python", "-m", "ai_player.training.self_play"]
